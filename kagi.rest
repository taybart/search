#!/usr/bin/env rest

config { no_flags = true }

cli {
  flags = {
    balance = {
      desc  = "Show balance when displaying results"
      short = "b"
      bool  = true
    }
    terse = {
      desc  = "Terse, append \"make it short and sweet\" for fastgpt"
      short = "t"
      bool  = true
    }
    limit = {
      desc    = "Terse, append \"make it short and sweet\" for fastgpt"
      short   = "l"
      default = "5"
    }
    search = {
      desc  = "Use search api instead of fastgpt"
      short = "s"
      bool  = true
    }
  }
  fn = <<LUA
    if #cli.rest == 0 then
      error("no query provided")
    end
    rest.exports.query = cli.rest:string()
    rest.exports.limit = cli.limit
    rest.exports.balance = cli.balance
    if cli.terse then
      rest.exports.query = cli.rest:string().." make it short and sweet"
    end
    if cli.search then
      return rest.label("search")
    end

    rest.label("fastgpt")
  LUA
}

locals {
  api  = "https://kagi.com/api/v0"
  auth = "Bot ${trim(read("~/.kagi/auth"))}"

  boilerplate = <<LUA
    local co = colors
    local cu = co.underlined

    print(co.f(
      {co.green, co.bold.e, cu.e}, 
      ('-> %s\n'):format(rest.exports.query or os.getenv("QUERY"))))

    if rest.res.status ~= 200 then
      fail("bad response from kagi")
      print(inspect(rest.res.body))
      return
    end

    local body = json.decode(rest.res.body)

    if rest.exports.balance then
      print(('%sapi balance: (%.2f)%s\n'):format(
        cu.red, body.meta.api_balance, co.reset))
    end
  LUA
}
request "search" {
  url = "${locals.api}/search"
  headers = {
    "Authorization" = locals.auth
  }
  query = {
    q     = try_exports("query", env("QUERY"))
    limit = try_exports("limit", env("LIMIT"))
  }
  after = <<LUA
    ${locals.boilerplate}

    for i, d in ipairs(body.data) do
      if d.t == 0 then
        local url = d.url or ''
        local title = d.title or d.url 
        local snippet = d.snippet:gsub("&#39;", "'"):gsub("&quot;", '"')

        print(('[%d] %s'):format(i, co.hyperlink(d.url, d.title, cu.blue)))
        print('\t'..snippet)
      end
    end
  LUA
}


request "fastgpt" {
  url    = "${locals.api}/fastgpt"
  method = "POST"
  headers = {
    "Authorization" = locals.auth
    "Content-Type"  = "application/json"
  }
  body = {
    query : try_exports("query", env("QUERY"))
    cache : true
  }
  after = <<LUA
    ${locals.boilerplate}

    local output = body.data.output
    :gsub('【', '[')
    :gsub('】', ']')
    :gsub("%*%*(.-)%*%*", co.f(co.bold.e, '%1'))
    print(output..'\n')
    for i, ref in ipairs(body.data.references) do
      print(('[%d] %s'):format(i, co.hyperlink(ref.url, ref.title, cu.blue)))
    end
  LUA
}
